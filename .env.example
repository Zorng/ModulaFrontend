API_BASE_URL=http://localhost:3000

# API prefixes (optional)
# Defaults in code match the current backend convention: /v1/<feature>
AUTH_API_PREFIX=/v1/auth
MENU_API_PREFIX=/v1/menu
INVENTORY_API_PREFIX=/v1/inventory
SALES_API_PREFIX=/v1/sales
CASH_API_PREFIX=/v1/cash
REPORTING_API_PREFIX=/v1/reports
POLICY_API_PREFIX=/v1/policies
ATTENDANCE_API_PREFIX=/v1/attendance
BRANCH_API_PREFIX=/v1/branches

# Attendance data source mode: `mock` or `api`
ATTENDANCE_REPOSITORY_MODE=mock

SHOW_DEBUG_ERRORS=true
